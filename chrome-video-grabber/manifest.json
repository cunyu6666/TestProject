{
  "manifest_version": 3,
  "name": "Video Grabber",
  "version": "0.1.0",
  "description": "Capture video resource URLs from Xiaohongshu, YouTube, and Bilibili (scaffold).",
  "action": {
    "default_title": "Video Grabber",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.xiaohongshu.com/*",
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.bilibili.com/*"
      ],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://*.xiaohongshu.com/*",
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.bilibili.com/*"
  ],
  "permissions": ["storage", "activeTab"]
}
