{
  "manifest_version": 3,
  "name": "Video Grabber",
  "version": "0.5.0",
  "description": "Detect video resource URLs on the active tab (generic + Bilibili + YouTube + Xiaohongshu) and list them for copy / download.",
  "action": {
    "default_title": "Video Grabber",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.bilibili.cn/*",
        "*://*.biliintl.com/*",
        "*://*.bili2233.cn/*"
      ],
      "js": ["content/extractors/bilibili-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.bilibili.cn/*",
        "*://*.biliintl.com/*",
        "*://*.bili2233.cn/*"
      ],
      "js": ["content/extractors/bilibili.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*"
      ],
      "js": ["content/extractors/youtube-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*"
      ],
      "js": ["content/extractors/youtube.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.xiaohongshu.com/*",
        "*://xiaohongshu.com/*",
        "*://*.xhslink.com/*",
        "*://xhslink.com/*"
      ],
      "js": ["content/extractors/xiaohongshu-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.xiaohongshu.com/*",
        "*://xiaohongshu.com/*",
        "*://*.xhslink.com/*",
        "*://xhslink.com/*"
      ],
      "js": ["content/extractors/xiaohongshu.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "webRequest",
    "downloads"
  ]
}
